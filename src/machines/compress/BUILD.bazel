load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# The library face (DESIGN.md): a runtime holding the dependencies and the header, proof blocks in, smaller blocks out.
cc_library(
    name = "compress",
    srcs = ["compress.cc"],
    hdrs = ["compress.h"],
    deps = [
        "//src/core:formula",
        "//src/parser",
        "//src/proof:ir",
        "//src/proof:proof_value",
        "//src/proof/nd:lowering",
        "//src/proof/nd:ops",
        "//src/proof/nd:stack",
        "//src/proof/nd:verifier",
        "//src/proof/translate:pass",
        "//src/runtime",
        "//src/util:error",
    ],
)

# The command line, for fol_compress in defs.bzl.
cc_binary(
    name = "fol_compress",
    srcs = ["main.cc"],
    deps = [
        ":compress",
        "//src/runtime",
    ],
)

cc_test(
    name = "compress_test",
    srcs = ["compress_test.cc"],
    deps = [
        ":compress",
        "//src/parser",
        "//src/runtime",
    ],
)
