    _h60 = forall_intro _h59
    qed _h60

proof Sys.invariance:
    _h1 = use Sys.reachable_def
    fix S
    _h2 = assume set(S)
    fix step
    _h3 = assume set(step)
    fix Init
    _h4 = assume set(Init)
    fix I
    _h5 = assume set(I)
    fix P
    _h6 = assume set(P)
    _h7 = assume (forall u. (set(u) -> (elem(u, I) -> elem(u, S))))
    _h8 = assume (forall u. (set(u) -> (elem(u, Init) -> elem(u, I))))
    _h9 = assume (forall x. (set(x) -> (elem(x, I) -> (forall a. (set(a) -> (forall b. (set(b) -> (forall u. (set(u) -> (Sys.transition(step, x, a, b, u) -> elem(u, I)))))))))))
    _h10 = assume (forall u. (set(u) -> (elem(u, I) -> elem(u, P))))
    fix s
    _h11 = assume set(s)
    _h12 = assume Sys.reachable(S, step, Init, s)
    _h13 = forall_elim _h1, S
    _h14 = forall_elim _h13, step
    _h15 = forall_elim _h14, Init
    _h16 = forall_elim _h15, s
    _h17 = iff_elim_l _h16, _h12
    _h18 = forall_elim _h17, I
    _h19 = implies_elim _h18, _h5
    _h20 = implies_elim _h19, _h7
    _h21 = implies_elim _h20, _h8
    _h22 = implies_elim _h21, _h9
    _h23 = forall_elim _h10, s
    _h24 = implies_elim _h23, _h11
    _h25 = implies_elim _h24, _h22
    _h26 = implies_intro _h25
    _h27 = implies_intro _h26
    _h28 = forall_intro _h27
    _h29 = implies_intro _h28
    _h30 = implies_intro _h29
    _h31 = implies_intro _h30
    _h32 = implies_intro _h31
    _h33 = implies_intro _h32
    _h34 = forall_intro _h33
    _h35 = implies_intro _h34
    _h36 = forall_intro _h35
    _h37 = implies_intro _h36
    _h38 = forall_intro _h37
    _h39 = implies_intro _h38
    _h40 = forall_intro _h39
    _h41 = implies_intro _h40
    _h42 = forall_intro _h41
    qed _h42
