proof Sys.reachable_init:
    _h1 = use Sys.reachable_def
    fix S
    _h2 = assume set(S)
    fix step
    _h3 = assume set(step)
    fix Init
    _h4 = assume set(Init)
    fix t0
    _h5 = assume set(t0)
    _h6 = assume elem(t0, Init)
    fix I0
    _h7 = assume set(I0)
    _h8 = assume (forall u. (set(u) -> (elem(u, I0) -> elem(u, S))))
    _h9 = assume (forall u. (set(u) -> (elem(u, Init) -> elem(u, I0))))
    _h10 = assume (forall x. (set(x) -> (elem(x, I0) -> (forall a. (set(a) -> (forall b. (set(b) -> (forall u. (set(u) -> (Sys.transition(step, x, a, b, u) -> elem(u, I0)))))))))))
    _h11 = forall_elim _h9, t0
    _h12 = implies_elim _h11, _h5
    _h13 = implies_elim _h12, _h6
    _h14 = implies_intro _h13
    _h15 = implies_intro _h14
    _h16 = implies_intro _h15
    _h17 = implies_intro _h16
    _h18 = forall_intro _h17
    _h19 = forall_elim _h1, S
    _h20 = forall_elim _h19, step
    _h21 = forall_elim _h20, Init
    _h22 = forall_elim _h21, t0
    _h23 = iff_elim_r _h22, _h18
    _h24 = implies_intro _h23
    _h25 = implies_intro _h24
    _h26 = forall_intro _h25
    _h27 = implies_intro _h26
    _h28 = forall_intro _h27
    _h29 = implies_intro _h28
    _h30 = forall_intro _h29
    _h31 = implies_intro _h30
    _h32 = forall_intro _h31
    qed _h32

proof Sys.reachable_step:
    _h1 = use Sys.reachable_def
    fix S
    _h2 = assume set(S)
    fix step
    _h3 = assume set(step)
    fix Init
    _h4 = assume set(Init)
    fix x0
    _h5 = assume set(x0)
    _h6 = assume Sys.reachable(S, step, Init, x0)
    fix a0
    _h7 = assume set(a0)
    fix b0
    _h8 = assume set(b0)
    fix u0
    _h9 = assume set(u0)
    _h10 = assume Sys.transition(step, x0, a0, b0, u0)
    fix I0
    _h11 = assume set(I0)
    _h12 = assume (forall u. (set(u) -> (elem(u, I0) -> elem(u, S))))
    _h13 = assume (forall u. (set(u) -> (elem(u, Init) -> elem(u, I0))))
    _h14 = assume (forall x. (set(x) -> (elem(x, I0) -> (forall a. (set(a) -> (forall b. (set(b) -> (forall u. (set(u) -> (Sys.transition(step, x, a, b, u) -> elem(u, I0)))))))))))
    _h15 = forall_elim _h1, S
    _h16 = forall_elim _h15, step
    _h17 = forall_elim _h16, Init
    _h18 = forall_elim _h17, x0
    _h19 = iff_elim_l _h18, _h6
    _h20 = forall_elim _h19, I0
    _h21 = implies_elim _h20, _h11
    _h22 = implies_elim _h21, _h12
    _h23 = implies_elim _h22, _h13
    _h24 = implies_elim _h23, _h14
    _h25 = forall_elim _h14, x0
    _h26 = implies_elim _h25, _h5
    _h27 = implies_elim _h26, _h24
    _h28 = forall_elim _h27, a0
    _h29 = implies_elim _h28, _h7
    _h30 = forall_elim _h29, b0
    _h31 = implies_elim _h30, _h8
    _h32 = forall_elim _h31, u0
    _h33 = implies_elim _h32, _h9
    _h34 = implies_elim _h33, _h10
    _h35 = implies_intro _h34
    _h36 = implies_intro _h35
    _h37 = implies_intro _h36
    _h38 = implies_intro _h37
    _h39 = forall_intro _h38
    _h40 = forall_elim _h1, S
    _h41 = forall_elim _h40, step
    _h42 = forall_elim _h41, Init
    _h43 = forall_elim _h42, u0
    _h44 = iff_elim_r _h43, _h39
    _h45 = implies_intro _h44
    _h46 = implies_intro _h45
    _h47 = forall_intro _h46
    _h48 = implies_intro _h47
    _h49 = forall_intro _h48
    _h50 = implies_intro _h49
