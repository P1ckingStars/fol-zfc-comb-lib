    fix H
    _h17 = assume (forall t. (set(t) -> (forall r. (set(r) -> (pmem(t, r, H) <-> (exists X. (set(X) & ((forall z. (set(z) -> (zero(z) -> snoc(z, z, X, t)))) & (forall t2. (set(t2) -> ((forall z. (set(z) -> (zero(z) -> snoc(z, z, X, t2)))) -> (forall r2. (set(r2) -> (apply(t2, r2, h) -> eq(r, r2)))))))))))))))
