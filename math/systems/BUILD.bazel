load("//build:fol.bzl", "fol_proof")
load("//src/machines/class:defs.bzl", "class_claim")

# Public: sys2fol's claims cite the systems library.
package(default_visibility = ["//visibility:public"])

fol_proof(
    name = "basic",
    header = "basic.fol.def",
    proof = "basic.fol.proof",
    deps = ["//lib:base"],
)

fol_proof(
    name = "reach",
    header = "reach.fol.def",
    proof = "reach.fol.proof",
    deps = [
        ":basic",
        "@zf//:ZF.Fixedpt",
    ],
)

fol_proof(
    name = "bisim",
    header = "bisim.fol.def",
    proof = "bisim.fol.proof",
    deps = [
        ":basic",
        "@zf//:ZF.Fixedpt",
    ],
)

# The class machine's claims the systems library cites. related_reachable: the states related by R to a reachable
# state of a system, as a set inside any set (step 4's J).
class_claim(
    name = "related_reachable_gen",
    request = "related_reachable.req",
    deps = [":reach"],
    out_def = "related_reachable.fol.def",
    out_proof = "related_reachable.fol.proof",
)

fol_proof(
    name = "related_reachable",
    header = "related_reachable.fol.def",
    proof = "related_reachable.fol.proof",
    deps = [
        ":reach",
        "//src/machines/class/rows",
    ],
)

fol_proof(
    name = "simulation",
    header = "simulation.fol.def",
    proof = "simulation.fol.proof",
    deps = [":related_reachable"],
)

# natural_exact: the class of the natural numbers, in the shape ZF's nat_induct is cited at.
class_claim(
    name = "natural_exact_gen",
    request = "natural_exact.req",
    deps = [":basic"],
    out_def = "natural_exact.fol.def",
    out_proof = "natural_exact.fol.proof",
)

fol_proof(
    name = "natural_exact",
    header = "natural_exact.fol.def",
    proof = "natural_exact.fol.proof",
    deps = [
        ":basic",
        "//src/machines/class/rows",
    ],
)

# Sys.natural's row, which ships with `natural`: the class machine reads Sys.natural through it.
class_claim(
    name = "natural_row_gen",
    request = "natural_row.req",
    deps = [":basic"],
    out_def = "natural_row.fol.def",
    out_proof = "natural_row.fol.proof",
)

fol_proof(
    name = "natural_row",
    header = "natural_row.fol.def",
    proof = "natural_row.fol.proof",
    deps = [
        ":basic",
        "//src/machines/class/rows",
    ],
)

fol_proof(
    name = "natural",
    header = "natural.fol.def",
    proof = "natural.fol.proof",
    deps = [
        ":natural_exact",
        ":natural_row",
        "@zf//:ZF.Nat",
    ],
)

# The facts sys2fol's proofs cite, proved once (sys2fol DESIGN.md, decision 21): sysprove wrote their proofs and the
# compression machine shortened them.
fol_proof(
    name = "tuple_facts",
    header = "tuple_facts.fol.def",
    proof = "tuple_facts.fol.proof",
    deps = ["//lib:base"],
)

# natural_cases: the naturals that are 0 or a successor. rest_pairs: a tuple's entries shifted down by one.
[class_claim(
    name = s + "_gen",
    request = s + ".req",
    deps = [":basic"],
    out_def = s + ".fol.def",
    out_proof = s + ".fol.proof",
) for s in [
    "natural_cases",
    "rest_pairs",
]]

[fol_proof(
    name = s,
    header = s + ".fol.def",
    proof = s + ".fol.proof",
    deps = [
        ":basic",
        "//src/machines/class/rows",
    ],
) for s in [
    "natural_cases",
    "rest_pairs",
]]

fol_proof(
    name = "natural_facts",
    header = "natural_facts.fol.def",
    proof = "natural_facts.fol.proof",
    deps = [
        ":natural",
        ":natural_cases",
        ":rest_pairs",
        ":tuple_facts",
    ],
)

# trace_prefix: the k at which the spec has a run matching a trace's first k steps, its state at k related to the
# implementation's (the induction behind Sys.simulation_refines).
class_claim(
    name = "trace_prefix_gen",
    request = "trace_prefix.req",
    deps = [":basic"],
    out_def = "trace_prefix.fol.def",
    out_proof = "trace_prefix.fol.proof",
)

fol_proof(
    name = "trace_prefix",
    header = "trace_prefix.fol.def",
    proof = "trace_prefix.fol.proof",
    deps = [
        ":basic",
        "//src/machines/class/rows",
    ],
)

fol_proof(
    name = "traces",
    header = "traces.fol.def",
    proof = "traces.fol.proof",
    deps = [
        ":simulation",
        ":trace_prefix",
        ":trace_prefix_back",
    ],
)

fol_proof(
    name = "equivalence",
    header = "equivalence.fol.def",
    proof = "equivalence.fol.proof",
    deps = [
        ":bisim",
        ":traces",
    ],
)

# trace_prefix_back: as trace_prefix, for a relation read backwards (Sys.converse_simulation_refines).
class_claim(
    name = "trace_prefix_back_gen",
    request = "trace_prefix_back.req",
    deps = [":basic"],
    out_def = "trace_prefix_back.fol.def",
    out_proof = "trace_prefix_back.fol.proof",
)

fol_proof(
    name = "trace_prefix_back",
    header = "trace_prefix_back.fol.def",
    proof = "trace_prefix_back.fol.proof",
    deps = [
        ":basic",
        "//src/machines/class/rows",
    ],
)
