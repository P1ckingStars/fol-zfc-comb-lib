proof Sys.tuple1_EX:
    _h1 = use zero_EX
    _h2 = use snoc_EX
    _h3 = use zero_UNIQ
    _h4 = use snoc_CONG
    _h5 = use eq_refl
    fix X
    _h6 = assume set(X)
    _h7 = exists_elim _h1, z0
    _h8 = and_elim_l _h7
    _h9 = and_elim_r _h7
    _h10 = forall_elim _h2, z0
    _h11 = implies_elim _h10, _h8
    _h12 = forall_elim _h11, z0
    _h13 = implies_elim _h12, _h8
    _h14 = forall_elim _h13, X
    _h15 = implies_elim _h14, _h6
    _h16 = exists_elim _h15, t0
    _h17 = and_elim_l _h16
    _h18 = and_elim_r _h16
    fix zA
    _h19 = assume set(zA)
    _h20 = assume zero(zA)
    _h21 = forall_elim _h3, z0
    _h22 = implies_elim _h21, _h8
    _h23 = forall_elim _h22, zA
    _h24 = implies_elim _h23, _h19
    _h25 = implies_elim _h24, _h9
    _h26 = implies_elim _h25, _h20
    _h27 = forall_elim _h5, X
    _h28 = forall_elim _h4, z0
    _h29 = forall_elim _h28, zA
    _h30 = forall_elim _h29, z0
    _h31 = forall_elim _h30, zA
    _h32 = forall_elim _h31, X
    _h33 = forall_elim _h32, X
    _h34 = forall_elim _h33, t0
    _h35 = implies_elim _h34, _h26
    _h36 = implies_elim _h35, _h26
    _h37 = implies_elim _h36, _h27
    _h38 = implies_elim _h37, _h18
    _h39 = implies_intro _h38
    _h40 = implies_intro _h39
    _h41 = forall_intro _h40
    _h42 = and_intro _h17, _h41
    _h43 = exists_intro _h42, t0
    _h44 = exists_intro _h43
    _h45 = exists_intro _h44
    _h46 = implies_intro _h45
    _h47 = forall_intro _h46
    qed _h47

proof Sys.wellformed_init:
    _h1 = use Sys.wellformed_def
    fix S
    fix A
    fix B
    fix step
    fix Init
    _h2 = assume Sys.wellformed(S, A, B, step, Init)
    _h3 = forall_elim _h1, S
    _h4 = forall_elim _h3, A
    _h5 = forall_elim _h4, B
    _h6 = forall_elim _h5, step
    _h7 = forall_elim _h6, Init
    _h8 = iff_elim_l _h7, _h2
    _h9 = and_elim_l _h8
    _h10 = implies_intro _h9
    _h11 = forall_intro _h10
    _h12 = forall_intro _h11
    _h13 = forall_intro _h12
    _h14 = forall_intro _h13
    _h15 = forall_intro _h14
    qed _h15

