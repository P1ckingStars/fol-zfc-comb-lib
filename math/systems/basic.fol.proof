proof Sys.related_mono:
    _h1 = use Sys.related_def
    fix R
    fix R2
    _h2 = assume (forall u. (set(u) -> (elem(u, R) -> elem(u, R2))))
    fix x
    _h3 = assume set(x)
    fix y
    _h4 = assume set(y)
    _h5 = assume Sys.related(R, x, y)
    _h6 = forall_elim _h1, R
    _h7 = forall_elim _h6, x
    _h8 = forall_elim _h7, y
    _h9 = iff_elim_l _h8, _h5
    _h10 = exists_elim _h9, q
    _h11 = and_elim_l _h10
    _h12 = and_elim_r _h10
    _h13 = and_elim_l _h12
    _h14 = and_elim_r _h12
    _h15 = forall_elim _h2, q
    _h16 = implies_elim _h15, _h11
    _h17 = implies_elim _h16, _h13
    _h18 = and_intro _h17, _h14
    _h19 = and_intro _h11, _h18
    _h20 = exists_intro _h19, q
    _h21 = exists_intro _h20
    _h22 = forall_elim _h1, R2
    _h23 = forall_elim _h22, x
    _h24 = forall_elim _h23, y
    _h25 = iff_elim_r _h24, _h21
    _h26 = implies_intro _h25
    _h27 = implies_intro _h26
    _h28 = forall_intro _h27
    _h29 = implies_intro _h28
    _h30 = forall_intro _h29
    _h31 = implies_intro _h30
    _h32 = forall_intro _h31
    _h33 = forall_intro _h32
    qed _h33
