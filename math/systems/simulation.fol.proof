proof Sys.simulation_safety:
    _h1 = use Sys.simulation_reach
    fix S1
    _h2 = assume set(S1)
    fix step1
    _h3 = assume set(step1)
    fix Init1
    _h4 = assume set(Init1)
    fix S2
    _h5 = assume set(S2)
    fix step2
    _h6 = assume set(step2)
    fix Init2
    _h7 = assume set(Init2)
    fix R
    _h8 = assume set(R)
    fix P
    _h9 = assume set(P)
    fix Q
    _h10 = assume set(Q)
    _h11 = assume (forall u. (set(u) -> (elem(u, Init1) -> elem(u, S1))))
    _h12 = assume (forall x. (set(x) -> (elem(x, S1) -> (forall a. (set(a) -> (forall b. (set(b) -> (forall u. (set(u) -> (Sys.transition(step1, x, a, b, u) -> elem(u, S1)))))))))))
    _h13 = assume Sys.simulation(step1, Init1, step2, Init2, R)
    _h14 = assume (forall t. (set(t) -> (Sys.reachable(S2, step2, Init2, t) -> elem(t, Q))))
    _h15 = assume (forall s. (set(s) -> (forall t. (set(t) -> (Sys.related(R, s, t) -> (elem(t, Q) -> elem(s, P)))))))
    fix s0
    _h16 = assume set(s0)
    _h17 = assume Sys.reachable(S1, step1, Init1, s0)
    _h18 = forall_elim _h1, S1
    _h19 = implies_elim _h18, _h2
    _h20 = forall_elim _h19, step1
    _h21 = implies_elim _h20, _h3
    _h22 = forall_elim _h21, Init1
    _h23 = implies_elim _h22, _h4
    _h24 = forall_elim _h23, S2
    _h25 = implies_elim _h24, _h5
    _h26 = forall_elim _h25, step2
    _h27 = implies_elim _h26, _h6
    _h28 = forall_elim _h27, Init2
    _h29 = implies_elim _h28, _h7
