    _h31 = implies_elim _h30, _h8
    _h32 = implies_elim _h31, _h11
    _h33 = implies_elim _h32, _h12
    _h34 = implies_elim _h33, _h13
    _h35 = forall_elim _h34, s0
    _h36 = implies_elim _h35, _h16
    _h37 = implies_elim _h36, _h17
    _h38 = exists_elim _h37, t0
