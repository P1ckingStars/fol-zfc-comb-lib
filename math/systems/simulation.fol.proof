    _h47 = implies_elim _h46, _h16
    _h48 = forall_elim _h47, t0
    _h49 = implies_elim _h48, _h39
    _h50 = implies_elim _h49, _h42
    _h51 = implies_elim _h50, _h45
    _h52 = exists_intro _h51
    _h53 = implies_intro _h52
    _h54 = implies_intro _h53
