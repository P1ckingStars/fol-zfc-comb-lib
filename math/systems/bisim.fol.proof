proof Sys.coinduction:
    _h1 = use Sys.bisimilar_def
    fix S1
    _h2 = assume set(S1)
    fix step1
    _h3 = assume set(step1)
    fix S2
    _h4 = assume set(S2)
    fix step2
    _h5 = assume set(step2)
    fix R
    _h6 = assume set(R)
    _h7 = assume (forall q. (set(q) -> (elem(q, R) -> (exists x. (set(x) & (elem(x, S1) & (exists y. (set(y) & (elem(y, S2) & Sys.tuple2(q, x, y))))))))))
    _h8 = assume Sys.bisimulation(step1, step2, R)
    fix s
    _h9 = assume set(s)
    fix t
    _h10 = assume set(t)
    _h11 = assume Sys.related(R, s, t)
    _h12 = forall_elim _h1, S1
    _h13 = forall_elim _h12, step1
    _h14 = forall_elim _h13, S2
    _h15 = forall_elim _h14, step2
    _h16 = forall_elim _h15, s
    _h17 = forall_elim _h16, t
    _h18 = and_intro _h8, _h11
    _h19 = and_intro _h7, _h18
    _h20 = and_intro _h6, _h19
    _h21 = exists_intro _h20, R
    _h22 = iff_elim_r _h17, _h21
    _h23 = implies_intro _h22
    _h24 = implies_intro _h23
    _h25 = forall_intro _h24
    _h26 = implies_intro _h25
    _h27 = forall_intro _h26
    _h28 = implies_intro _h27
    _h29 = implies_intro _h28
    _h30 = implies_intro _h29
    _h31 = forall_intro _h30
    _h32 = implies_intro _h31
    _h33 = forall_intro _h32
    _h34 = implies_intro _h33
    _h35 = forall_intro _h34
    _h36 = implies_intro _h35
    _h37 = forall_intro _h36
    _h38 = implies_intro _h37
    _h39 = forall_intro _h38
    qed _h39
