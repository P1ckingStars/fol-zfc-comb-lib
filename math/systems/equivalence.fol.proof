    _h43 = and_elim_r _h39
    _h44 = and_elim_r _h43
    _h45 = forall_elim _h6, s0
    _h46 = implies_elim _h45, _h40
    _h47 = implies_elim _h46, _h44
    _h48 = and_intro _h42, _h47
