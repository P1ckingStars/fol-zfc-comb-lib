proof Sys.bisimilar_equivalent:
    _h1 = use Sys.refines_def
    _h2 = use Sys.equivalent_def
    _h3 = use Sys.bisimilar_def
    _h4 = use Sys.bisimulation_def
    _h5 = use Sys.simulation_def
    _h6 = use Sys.simulation_refines
    _h7 = use Sys.converse_simulation_refines
    _h8 = use Sys.trace_start
    _h9 = use Sys.trace_mono
    _h10 = use upair_ex
    _h11 = use upair_mem1
    _h12 = use upair_elem
    _h13 = use Sys.related_cong
    _h14 = use eq_symm
    _h15 = use eq_refl
    _h16 = use elem_first_subst
    fix S1
    _h17 = assume set(S1)
    fix step1
    _h18 = assume set(step1)
    fix Init1
    _h19 = assume set(Init1)
    fix S2
    _h20 = assume set(S2)
    fix step2
    _h21 = assume set(step2)
    fix Init2
    _h22 = assume set(Init2)
    _h23 = assume (forall s. (set(s) -> (elem(s, Init1) -> (exists t. (set(t) & (elem(t, Init2) & Sys.bisimilar(S1, step1, S2, step2, s, t)))))))
    _h24 = assume (forall t. (set(t) -> (elem(t, Init2) -> (exists s. (set(s) & (elem(s, Init1) & Sys.bisimilar(S1, step1, S2, step2, s, t)))))))
    fix trF
    _h25 = assume set(trF)
    _h26 = assume Sys.trace(step1, Init1, trF)
    _h27 = forall_elim _h8, step1
    _h28 = implies_elim _h27, _h18
    _h29 = forall_elim _h28, Init1
    _h30 = implies_elim _h29, _h19
    _h31 = forall_elim _h30, trF
