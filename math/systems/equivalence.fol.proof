proof Sys.trace_mono:
    _h1 = use Sys.trace_def
    _h2 = use Sys.run_def
    fix step
    _h3 = assume set(step)
    fix I
    _h4 = assume set(I)
    fix J
    _h5 = assume set(J)
    _h6 = assume (forall u. (set(u) -> (elem(u, I) -> elem(u, J))))
    fix tr
    _h7 = assume set(tr)
    _h8 = assume Sys.trace(step, I, tr)
    _h9 = forall_elim _h1, step
    _h10 = forall_elim _h9, I
