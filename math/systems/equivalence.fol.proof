    _h35 = and_elim_l _h34
    _h36 = and_elim_r _h32
    _h37 = and_elim_r _h36
    _h38 = exists_elim _h37, s0
    _h39 = and_elim_l _h38
    _h40 = and_elim_r _h38
    _h41 = and_elim_l _h40
    _h42 = and_elim_r _h38
    _h43 = and_elim_r _h42
    fix I0
