proof Sys.bisimilar_forth:
    _h1 = use Sys.bisimilar_def
    _h2 = use Sys.bisimulation_def
    fix S1
    _h3 = assume set(S1)
    fix step1
    _h4 = assume set(step1)
    fix S2
    _h5 = assume set(S2)
    fix step2
    _h6 = assume set(step2)
    fix x
    _h7 = assume set(x)
    fix y
    _h8 = assume set(y)
    _h9 = assume Sys.bisimilar(S1, step1, S2, step2, x, y)
    _h10 = forall_elim _h1, S1
    _h11 = forall_elim _h10, step1
    _h12 = forall_elim _h11, S2
    _h13 = forall_elim _h12, step2
    _h14 = forall_elim _h13, x
    _h15 = forall_elim _h14, y
    _h16 = iff_elim_l _h15, _h9
    _h17 = exists_elim _h16, R
    _h18 = and_elim_l _h17
    _h19 = and_elim_r _h17
    _h20 = and_elim_l _h19
    _h21 = and_elim_r _h19
    _h22 = and_elim_l _h21
    _h23 = and_elim_r _h21
    _h24 = forall_elim _h2, step1
    _h25 = forall_elim _h24, step2
    _h26 = forall_elim _h25, R
    _h27 = iff_elim_l _h26, _h22
    _h28 = forall_elim _h27, x
    _h29 = implies_elim _h28, _h7
    _h30 = forall_elim _h29, y
    _h31 = implies_elim _h30, _h8
    _h32 = implies_elim _h31, _h23
    _h33 = and_elim_l _h32
    fix a
    _h34 = assume set(a)
    fix b
    _h35 = assume set(b)
    fix x2
    _h36 = assume set(x2)
    _h37 = assume Sys.transition(step1, x, a, b, x2)
    _h38 = forall_elim _h33, a
    _h39 = implies_elim _h38, _h34
    _h40 = forall_elim _h39, b
    _h41 = implies_elim _h40, _h35
    _h42 = forall_elim _h41, x2
    _h43 = implies_elim _h42, _h36
    _h44 = implies_elim _h43, _h37
    _h45 = exists_elim _h44, y2
    _h46 = and_elim_l _h45
    _h47 = and_elim_r _h45
    _h48 = and_elim_l _h47
    _h49 = and_elim_r _h45
    _h50 = and_elim_r _h49
    _h51 = forall_elim _h1, S1
    _h52 = forall_elim _h51, step1
    _h53 = forall_elim _h52, S2
    _h54 = forall_elim _h53, step2
    _h55 = forall_elim _h54, x2
    _h56 = forall_elim _h55, y2
    _h57 = and_intro _h22, _h50
    _h58 = and_intro _h20, _h57
    _h59 = and_intro _h18, _h58
    _h60 = exists_intro _h59, R
    _h61 = iff_elim_r _h56, _h60
    _h62 = and_intro _h48, _h61
    _h63 = and_intro _h46, _h62
    _h64 = exists_intro _h63, y2
    _h65 = exists_intro _h64
    _h66 = implies_intro _h65
    _h67 = implies_intro _h66
    _h68 = forall_intro _h67
    _h69 = implies_intro _h68
    _h70 = forall_intro _h69
    _h71 = implies_intro _h70
    _h72 = forall_intro _h71
    _h73 = exists_intro _h72
    _h74 = implies_intro _h73
    _h75 = implies_intro _h74
    _h76 = forall_intro _h75
    _h77 = implies_intro _h76
    _h78 = forall_intro _h77
    _h79 = implies_intro _h78
    _h80 = forall_intro _h79
    _h81 = implies_intro _h80
    _h82 = forall_intro _h81
    _h83 = implies_intro _h82
