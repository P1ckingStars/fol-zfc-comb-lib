    _h60 = and_intro _h29, _h59
    _h61 = and_intro _h27, _h60
    _h62 = iff_elim_r _h58, _h61
    _h63 = forall_elim _h1, step
    _h64 = forall_elim _h63, J
    _h65 = forall_elim _h64, tr
    _h66 = and_intro _h19, _h62
    _h67 = exists_intro _h66, run
    _h68 = and_intro _h16, _h67
    _h69 = and_intro _h14, _h68
